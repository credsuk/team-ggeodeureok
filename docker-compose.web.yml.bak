services:
  web:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: council-web
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - "C:/Users/Admin/.cache/huggingface/hub/models--dragonkue--snowflake-arctic-embed-l-v2.0-ko:/models/arctic-cache:ro"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "8000:8000"
