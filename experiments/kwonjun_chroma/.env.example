POSTGRES_USER=council
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=council_vectors
POSTGRES_PORT=5432
PGVECTOR_DSN=postgresql://council:change-this-local-password@localhost:5432/council_vectors

# 전체 임베딩 이후 검색/API/데모 공통 설정
COUNCIL_EMBEDDING_DIR=data/embeddings/arctic_raw_v1
COUNCIL_PARENT_PATH=data/canonical_v3/chunks_v1/parents.parquet
COUNCIL_CHROMA_DIR=data/chroma/arctic_raw_v1
COUNCIL_CHROMA_COLLECTION=council_arctic_raw_v1
COUNCIL_PG_TABLE=council_arctic_raw_v1
COUNCIL_PG_EF_SEARCH=200
COUNCIL_DEVICE=auto
COUNCIL_MODEL_CACHE=models/huggingface
COUNCIL_ALLOW_DOWNLOAD=0

# 로컬 Agent: localhost 외 URL은 보안상 거부됩니다.
OLLAMA_URL=http://127.0.0.1:11434
COUNCIL_AGENT_MODEL=qwen3:8b
# 질문 해석용 모델(비우면 COUNCIL_AGENT_MODEL 사용). 작은 모델을 쓰면 응답이 빨라짐
COUNCIL_PARSER_MODEL=
COUNCIL_PARSER_TIMEOUT=120

# 후속 흐름·전망 시점: live = 외부 데이터 조회일 기준(전망은 조회일 이후), backtest = 회의록 기준일 기준(사후 점검)
COUNCIL_FOLLOWUP_MODE=live
# 회의록 근거 기준일 (보유 회의록 범위)
COUNCIL_MINUTES_CUTOFF=2025-12-31

# ---------------------------------------------------------------------------
# 외부 공공 API 인증값 — 서버 .env에만 두고 유저에게 배포하지 않습니다.
# 비워 두면 해당 출처만 꺼지고 나머지는 그대로 동작합니다.
# 외부로는 검증된 짧은 정책어와 KOSIS 통계표 ID만 전송되며, 질문·회의록 원문은 전송되지 않습니다.
# ---------------------------------------------------------------------------
# 법제처 국가법령정보 공동활용 (자치법규 목록) — https://open.law.go.kr 에서 OC(이메일 ID) 발급
LAW_OC=
# 국회사무처 열린국회정보 (의원 발의법률안) — https://open.assembly.go.kr 에서 인증키 발급
ASSEMBLY_API_KEY=
# 통계청 KOSIS 공유서비스 (시도별 통계) — https://kosis.kr/openapi 에서 인증키 발급
KOSIS_API_KEY=

COUNCIL_ISSUE_PAYLOAD=outputs/web/birth_rate_issue.json
COUNCIL_EXTERNAL_CONTEXT=outputs/external/external_context.json

