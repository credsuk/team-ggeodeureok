# 제출 폴더 루트에서 `.env`로 복사한 뒤 값을 채웁니다:  copy .env.example .env
# .env는 제출물·Git에 포함하지 않습니다.

# ---- PostgreSQL + pgvector (docker-compose.yml 기본값과 동일) ----
# 호스트 포트는 15432: 로컬에 설치된 PostgreSQL(기본 5432)과 충돌하지 않도록 바꿈
POSTGRES_USER=council
POSTGRES_PASSWORD=council-local-only
POSTGRES_DB=council_vectors
POSTGRES_PORT=15432
PGVECTOR_DSN=postgresql://council:council-local-only@127.0.0.1:15432/council_vectors
COUNCIL_PG_TABLE=council_arctic_raw_v1
COUNCIL_PG_EF_SEARCH=200

# ---- 임베딩·검색 ----
# auto | cpu | cuda
COUNCIL_DEVICE=auto
# scripts/download_models.py가 내려받는 model/huggingface 폴더의 "절대경로"
# (노트북은 notebooks/에서, 서버는 루트에서 실행되므로 상대경로는 쓰지 않습니다)
# 예) COUNCIL_MODEL_CACHE=C:/submission/model/huggingface   · 비우면 기본 HF 캐시(~/.cache/huggingface/hub)
COUNCIL_MODEL_CACHE=
# 1이면 캐시에 모델이 없을 때 Hugging Face에서 내려받음
COUNCIL_ALLOW_DOWNLOAD=0
COUNCIL_EMBEDDING_MODEL=dragonkue/snowflake-arctic-embed-l-v2.0-ko
COUNCIL_EMBEDDING_REVISION=55ec6e9358a56d56af759bc8372e970caf8c305f
COUNCIL_MAX_SEQ_LENGTH=2048
COUNCIL_RETRIEVAL_MODE=hybrid
COUNCIL_RRF_K=60
COUNCIL_DENSE_WEIGHT=1.0
COUNCIL_TEXT_WEIGHT=1.0

# 원본 파이프라인 스크립트(src/01~35) 산출물 위치
COUNCIL_EMBEDDING_DIR=data/embeddings/arctic_raw_v1
COUNCIL_PARENT_PATH=data/canonical_v3/chunks_v1/parents.parquet
COUNCIL_BM25_INDEX=data/bm25/arctic_raw_v1/bm25.sqlite3

# ---- 로컬 LLM (Ollama, localhost만 허용) ----
OLLAMA_URL=http://127.0.0.1:11434
AUTO_START_OLLAMA=1
COUNCIL_AGENT_MODEL=hf.co/mykor/A.X-4.0-Light-gguf:Q4_K_M
COUNCIL_AGENT_TIMEOUT=240
COUNCIL_AGENT_NUM_CTX=8192
# 질문 해석용 모델. 비우면 COUNCIL_AGENT_MODEL을 사용
COUNCIL_PARSER_MODEL=
COUNCIL_PARSER_TIMEOUT=120

# ---- 외부 공공데이터 (선택, 참고용·예측 입력 제외) ----
# backtest: 회의록 기준일까지의 외부 정보만 사용 (대회 제출 기본값)
COUNCIL_FOLLOWUP_MODE=backtest
COUNCIL_MINUTES_CUTOFF=2025-12-31
COUNCIL_EXTERNAL_CACHE=data/external/cache
# 인증값은 심사용 임시 인증정보를 별도로 전달합니다. 비워 두면 해당 출처는 건너뜁니다.
LAW_OC=
ASSEMBLY_API_KEY=
KOSIS_API_KEY=

# ---- API 서버 (src/main.py, 노트북 04) ----
HOST=127.0.0.1
PORT=8000
