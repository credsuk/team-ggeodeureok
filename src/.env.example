POSTGRES_USER=council
POSTGRES_PASSWORD=council-local-only
POSTGRES_DB=council_vectors
POSTGRES_PORT=5432
PGVECTOR_DSN=postgresql://council:council-local-only@localhost:5432/council_vectors

# 전체 임베딩 이후 검색/API/데모 공통 설정
COUNCIL_EMBEDDING_DIR=data/embeddings/arctic_raw_v1
COUNCIL_PARENT_PATH=data/canonical_v3/chunks_v1/parents.parquet
COUNCIL_CHROMA_DIR=data/chroma/arctic_raw_v1
COUNCIL_CHROMA_COLLECTION=council_arctic_raw_v1
COUNCIL_PG_TABLE=council_arctic_raw_v1
COUNCIL_PG_EF_SEARCH=200
COUNCIL_RETRIEVAL_MODE=hybrid
COUNCIL_BM25_INDEX=data/bm25/arctic_raw_v1/bm25.sqlite3
COUNCIL_RRF_K=60
COUNCIL_DENSE_WEIGHT=1.0
COUNCIL_BM25_WEIGHT=1.0
COUNCIL_DEVICE=auto
COUNCIL_MODEL_CACHE=
COUNCIL_ALLOW_DOWNLOAD=0

# 로컬 Agent: localhost 외 URL은 보안상 거부됩니다.
OLLAMA_URL=http://127.0.0.1:11434
COUNCIL_AGENT_MODEL=qwen3:8b
COUNCIL_AGENT_TIMEOUT=90
# 질문 해석용 모델. 비우면 COUNCIL_AGENT_MODEL을 사용합니다.
COUNCIL_PARSER_MODEL=
COUNCIL_PARSER_TIMEOUT=120

# 대회 제출 기본값은 기준일 이후 정보를 차단하는 backtest입니다.
# live는 별도 데모·사후 탐색에서만 명시적으로 사용하세요.
COUNCIL_FOLLOWUP_MODE=backtest
COUNCIL_MINUTES_CUTOFF=2025-12-31
COUNCIL_EXTERNAL_CACHE=data/external/cache

# 외부 공공 API 인증값은 실제 .env에만 저장하고 Git에 올리지 않습니다.
# 외부로는 검증된 짧은 정책어와 KOSIS 통계표 ID만 전송됩니다.
LAW_OC=
ASSEMBLY_API_KEY=
KOSIS_API_KEY=

COUNCIL_ISSUE_PAYLOAD=outputs/web/birth_rate_issue.json
COUNCIL_EXTERNAL_CONTEXT=outputs/external/external_context.json

