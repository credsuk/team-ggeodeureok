# Copy this file to your shell environment or export the values there.
# Relative paths resolve from the mini_solo project root.
DATA_DIR=data
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=assembly_metadata
EMBEDDING_MODEL=dragonkue/snowflake-arctic-embed-l-v2.0-ko
BM25_DB=data/bm25_index/assembly_bm25.sqlite3
SOURCE_METADATA_DB=data/source_metadata.sqlite3
ANSWER_CACHE_DB=data/answer_cache.sqlite3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/exaone3.5-abliterated
OLLAMA_KEEP_ALIVE=5m
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 선택 사항: 복수 Cross-Encoder를 쉼표로 나열하면 순위 앙상블을 사용합니다.
# 비워 두면 RERANKER_MODEL 하나만 사용합니다.
# RERANKER_MODELS=
# RERANKER_WEIGHTS=
# 한국어 Cross-Encoder 비교 예시: 두 줄을 함께 설정하고 모델을 먼저 캐시에 준비하세요.
# RERANKER_MODELS=BAAI/bge-reranker-v2-m3,dragonkue/bge-reranker-v2-m3-ko
# RERANKER_WEIGHTS=1.0,1.0
# 벡터 검색과 BM25 결과를 RRF로 합칠 때의 상대 가중치(둘 다 0이면 안 됩니다).
DENSE_RRF_WEIGHT=1.0
BM25_RRF_WEIGHT=1.0
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
ALLOW_MODEL_DOWNLOAD=0
DATA_VERSION=2024-2025-v1
PROMPT_VERSION=local-rag-v8
CACHE_SIMILARITY=0.94
DENSE_LIMIT=80
LEXICAL_LIMIT=120
CANDIDATE_LIMIT=300
RERANK_LIMIT=120
ANSWER_EVIDENCE_LIMIT=24
