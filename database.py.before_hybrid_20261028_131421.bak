import asyncpg
from config import settings

async def connect_db(database_url: str):
    pool = await asyncpg.create_pool(
        dsn=database_url,
        min_size=1,
        max_size=5,
        command_timeout=60,
    )
    try:
        async with pool.acquire() as conn:
            await conn.fetchval("SELECT 1")
            await conn.fetchval(
                "SELECT 1 FROM public.council_arctic_raw_v1 LIMIT 1"
            )
    except Exception:
        await pool.close()
        raise
    return pool

async def close_db(pool):
    if pool is not None:
        await pool.close()

def to_preview(value, max_chars=1800):
    if value is None:
        return ""
    return " ".join(str(value).split())[:max_chars]

async def search_minutes(pool, vector, limit=5, council=None, year=None):
    vector_str = "[" + ",".join(f"{float(v):.8f}" for v in vector) + "]"

    sql = """
        SELECT
            chunk_id AS row_id,
            meeting_date AS date,
            council AS assembly,
            committee,
            meeting_name,
            agenda_title AS agenda,
            document,
            1 - (embedding <=> $1::vector) AS similarity
        FROM public.council_arctic_raw_v1
        WHERE ($2::text IS NULL OR council = $2)
          AND ($3::integer IS NULL OR year = $3)
        ORDER BY embedding <=> $1::vector
        LIMIT $4
    """

    async with pool.acquire() as conn:
        rows = await conn.fetch(sql, vector_str, council, year, limit)

    return [
        {
            "row_id": row["row_id"],
            "date": str(row["date"]) if row["date"] else "",
            "assembly": row["assembly"] or "",
            "committee": row["committee"] or "",
            "meetingName": row["meeting_name"] or "",
            "agenda": row["agenda"] or "",
            "speaker": "",
            "summary": "",
            "text": to_preview(row["document"]),
            "preview": to_preview(row["document"]),
            "parent": to_preview(row["document"], 5000),
            "similarity": round(float(row["similarity"]), 4),
        }
        for row in rows
    ]
