                <!-- BOTTOM CARD: [전체 17개 의회 시계열 관측 순서 스트림] -->
                <div class="glass-panel rounded-2xl border-2 border-slate-300 p-4 flex flex-col shadow-sm bg-white">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-2">
                        <div>
                            <h3 class="text-sm md:text-base font-black text-slate-950 flex items-center gap-1.5">
                                <i class="fa-solid fa-timeline text-sky-700"></i>
                                <span>의회별 최초 관측 순서 및 시차 전체 목록</span>
                            </h3>
                            <p class="text-xs text-slate-600 mt-0.5">지도 노드를 클릭하거나 목록 항목을 누르면 해당 의회 발언 및 전체 문맥이 위 카드에 펼쳐집니다.</p>
                        </div>
                        <span id="activeCouncilIndicator" class="text-xs text-sky-900 font-mono font-black shrink-0 px-2.5 py-1 rounded-lg bg-sky-100 border border-sky-300 shadow-sm">
                            선택: 서울특별시의회
                        </span>
                    </div>

                    <!-- Flow List Scroll Container -->
                    <div id="councilFlowList" class="space-y-2 overflow-y-auto max-h-[220px] pr-1">
                        <!-- Populated dynamically by JS with mentions count badges and active tab states -->
                    </div>
                </div>
            </section>

            <!-- Bottom Row: Monthly Discussion Intensity (복잡한 예측 그래프/퍼센티지 카드 제거 후 시계열 단독 전체 너비 확장) -->
            <section class="col-span-12 glass-panel rounded-2xl border border-slate-300 p-4 shadow-sm bg-white">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-chart-column text-[#eb604f] text-base"></i>
                        <h3 class="text-sm md:text-base font-black text-slate-950">
                            2024~2025 월별 논의 강도 시계열 (Monthly Trend)
                        </h3>
                    </div>
                    <span class="text-xs text-slate-600 font-mono font-bold">전국 17개 시·도의회 월별 실질 발언 건수 추이</span>
                </div>
                <div class="h-32 w-full flex items-end gap-1.5 pt-4 pb-1 px-3 bg-slate-50 rounded-xl border border-slate-200" id="monthlyChartBars">
                    <!-- Monthly Bars rendered dynamically by JS -->
                </div>
            </section>

            <!-- 공공 데이터 결합 예측 통합 노출 섹션 -->
            <section class="col-span-12 glass-panel rounded-2xl border border-slate-300 p-5 shadow-sm space-y-4 bg-white">
                <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                    <div>
                        <h2 class="text-base md:text-lg font-black text-slate-950 flex items-center gap-2">
                            <i class="fa-solid fa-brain-circuit text-emerald-700"></i>
                            <span>공공데이터(자치법규 조례 + 지역통계) 결합 차기 확산 예측</span>
                        </h2>
                        <p class="text-xs md:text-sm text-slate-700 mt-1 font-medium">
                            의회 회의록 내부 발언 신호에 법제처 자치법규(조례 제정 발의 건수) 및 공공 지역통계 수요지표를 융합하여 산출한 확산 순위입니다.
                        </p>
                    </div>
                    <span class="text-xs font-mono px-3 py-1 rounded bg-emerald-100 text-emerald-950 border border-emerald-400 font-bold shrink-0 shadow-sm">
                        Multi-Signal Fusion
                    </span>
                </div>

                <!-- 1위 예측 후보 상세 브리핑 카드 -->
                <div id="topForecastBriefCard" class="bg-gradient-to-r from-emerald-50 via-white to-sky-50 rounded-xl p-4 border border-emerald-300 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm">
                    <!-- Populated dynamically by JS -->
                </div>

                <!-- 17개 의회 예측 순위 테이블 -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-900">
                        <thead class="bg-slate-100 text-slate-800 text-xs md:text-sm uppercase font-mono border-b-2 border-slate-300 font-bold">
                            <tr>
                                <th class="p-3">순위</th>
                                <th class="p-3">광역의회명</th>
                                <th class="p-3">종합 확산점수</th>
                                <th class="p-3">회의록 신호</th>
                                <th class="p-3">공공데이터 점수</th>
                                <th class="p-3">광역 조례</th>
                                <th class="p-3">기초 조례</th>
                                <th class="p-3">지역통계 수요점수</th>
                                <th class="p-3">예상 시점</th>
                            </tr>
                        </thead>
                        <tbody id="forecastRankingTableBody" class="divide-y divide-slate-200">
                            <!-- Populated dynamically by JS -->
                        </tbody>
                    </table>
                </div>

                <!-- External Sources & Attribution -->
                <div class="pt-2 text-xs text-slate-600 flex flex-col space-y-1">
                    <span class="font-bold text-slate-800"><i class="fa-solid fa-scale-balanced mr-1"></i>데이터 연계 출처:</span>
                    <span>1. 국가법령정보센터 자치법규 API (법제처) · 2. e-지방지표 인구소멸위험지수 및 청년이동통계 (통계청/행정안전부)</span>
                </div>
            </section>
        </div>

        <!-- ========================================================================================= -->
        <!-- TAB 3: 📄 근거 원문 상세 내용 (밝은 테마) -->
        <!-- ========================================================================================= -->
        <div id="tabContent-search" class="tab-content hidden flex-col space-y-4">
            <div class="glass-panel rounded-2xl border border-slate-300 p-5 shadow-sm bg-white">
                <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-3">
                    <div>
                        <h2 class="text-lg font-black text-slate-950 flex items-center gap-2">
                            <i class="fa-solid fa-file-lines text-purple-700"></i>
                            <span>전국 17개 광역의회 회의록 통합 의미 기반 검색기</span>
                        </h2>
                        <p class="text-sm md:text-base text-slate-700 mt-1 font-medium">
                            전국 시·도의회 회의록 전체 데이터를 기반으로 유사 정책 발언 및 의원 질의응답을 정밀 검색합니다.
                        </p>
                    </div>
                    <div class="text-xs font-bold text-purple-950 bg-purple-100 px-3.5 py-1.5 rounded-lg border border-purple-300 shadow-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-info text-purple-700"></i>
                        <span>총 검색 결과 중 상위 20개 결과만 표시됩니다</span>
                    </div>
                </div>

                <!-- Search Query Form Controls -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 mb-4">
                    <div class="md:col-span-5">
                        <label class="block text-xs md:text-sm font-bold text-slate-800 mb-1">검색 질의 (정책·현안)</label>
                        <input type="text" id="rawSearchQuery" value="지방소멸 대응 청년 주거 및 빈집 정비 지원 조례" class="w-full px-3.5 py-2.5 bg-white border-2 border-slate-300 rounded-lg text-sm text-slate-950 focus:border-purple-600 font-bold shadow-sm">
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-xs md:text-sm font-bold text-slate-800 mb-1">의회 필터</label>
                        <select id="rawSearchCouncilFilter" class="w-full px-3.5 py-2.5 bg-white border-2 border-slate-300 rounded-lg text-sm text-slate-950 font-bold shadow-sm">
                            <option value="">전체 17개 시·도의회</option>
                            <option value="서울특별시의회">서울특별시의회</option>
                            <option value="경기도의회">경기도의회</option>
                            <option value="강원특별자치도의회">강원특별자치도의회</option>
                            <option value="경상북도의회">경상북도의회</option>
                            <option value="전라남도의회">전라남도의회</option>
                            <option value="부산광역시의회">부산광역시의회</option>
                            <option value="대전광역시의회">대전광역시의회</option>
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs md:text-sm font-bold text-slate-800 mb-1">연도</label>
                        <select id="rawSearchYearFilter" class="w-full px-3.5 py-2.5 bg-white border-2 border-slate-300 rounded-lg text-sm text-slate-950 font-bold shadow-sm">
                            <option value="all">전체 (2024~2025)</option>
                            <option value="2024">2024년</option>
                            <option value="2025">2025년</option>
                        </select>
                    </div>
                    <div class="md:col-span-2 flex items-end">
                        <button onclick="executeRawVectorSearch()" class="w-full py-2.5 bg-purple-700 hover:bg-purple-600 text-white rounded-lg text-sm font-black shadow-md transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-magnifying-glass"></i> 발언 원문 검색
                        </button>
                    </div>
                </div>

                <!-- Search Metrics -->
                <div class="flex items-center justify-between flex-wrap gap-3 text-xs md:text-sm font-mono text-slate-700 border-t border-slate-200 pt-2.5 mb-3 font-bold">
                    <div class="flex items-center gap-3">
                        <span>검색 결과: <b id="rawSearchResultCount" class="text-purple-700 font-black">20</b>건 표시 (관련도 높은 상위 순)</span>
                        <span>|</span>
                        <span>검색 응답 시간: <b id="rawSearchDbMs" class="text-emerald-700 font-black">18.4</b> ms</span>
                    </div>
                    <div class="text-xs font-sans text-slate-600 bg-slate-100 px-2.5 py-1 rounded border border-slate-300 font-medium">
                        ※ 시스템 응답 속도 최적화를 위해 관련도 상위 20개 결과만 우선 노출합니다.
                    </div>
                </div>

                <!-- Results List -->
                <div id="rawSearchResultsContainer" class="space-y-3">
                    <!-- Populated dynamically by JS -->
                </div>
            </div>
        </div>

    </main>

    <!-- ========================================================================================= -->
    <!-- 🔹 플로팅 AI 에이전트 챗봇 (채널톡 스타일 웹사이트 우측 하단 미니 팝업) -->
    <!-- ========================================================================================= -->
    <!-- Floating Trigger Icon Button -->
    <div class="fixed bottom-6 right-6 z-50">
        <button onclick="toggleFloatingChat()" id="floatingChatBtn" title="AI 의정 비서에게 질문하기" class="floating-chat-btn relative w-14 h-14 rounded-full bg-gradient-to-tr from-sky-600 via-indigo-600 to-rose-600 text-white flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95 transition-all cursor-pointer">
            <i class="fa-solid fa-comments text-2xl"></i>
            <span id="chatUnreadBadge" class="absolute top-0 right-0 flex h-3.5 w-3.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-rose-500 border-2 border-white"></span>
            </span>
        </button>
    </div>

    <!-- Floating Chat Window Modal -->
    <div id="floatingChatModal" class="hidden fixed bottom-24 right-6 w-[410px] max-w-[calc(100vw-2rem)] h-[620px] max-h-[calc(100vh-8rem)] bg-white border-2 border-sky-500 rounded-2xl shadow-2xl flex-col z-50 overflow-hidden transition-all duration-200">
        <!-- Chat Header -->
        <div class="px-4 py-3 bg-sky-50 border-b border-slate-200 flex items-center justify-between shrink-0">
            <div class="flex items-center space-x-2.5">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-sky-600 to-indigo-600 flex items-center justify-center text-white text-sm shadow-md">
                    <i class="fa-solid fa-robot"></i>
                </div>
                <div>
                    <h3 class="text-sm font-black text-slate-950 flex items-center gap-1.5">
                        <span>로컬 의정 AI 에이전트</span>
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    </h3>
                    <p class="text-[11px] text-slate-600 font-bold">17개 시·도의회 빅데이터 기반 실시간 정책 답변</p>
                </div>
            </div>
            <button onclick="toggleFloatingChat()" class="text-slate-500 hover:text-slate-900 p-1 rounded-lg hover:bg-slate-200 transition-colors cursor-pointer">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>
        </div>

        <!-- Chat History Messages Container -->
        <div id="agentChatContainer" class="flex-1 overflow-y-auto space-y-3 p-3.5 text-xs md:text-sm bg-slate-100">
            <!-- Welcome Initial Message -->
            <div class="flex items-start space-x-2.5">
                <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-sky-600 to-indigo-600 text-white flex items-center justify-center text-xs shrink-0 mt-0.5 shadow-sm">
                    <i class="fa-solid fa-robot"></i>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-3.5 text-slate-900 max-w-[88%] leading-relaxed shadow-sm space-y-2">
                    <p class="font-black text-sky-800 text-sm">안녕하세요! 의정이슈레이더 AI 비서입니다.</p>
                    <p class="text-slate-800 text-xs md:text-sm font-medium">17개 시·도의회 회의록 빅데이터를 바탕으로 정책의 최초 발원지, 전국 확산 순서, 원문 발언 근거를 안내해 드립니다.</p>
                    <div class="pt-2 border-t border-slate-200 flex flex-col gap-1.5">
                        <button onclick="askAgentPredefined('전세사기 피해 지원이 어느 의회에서 먼저 논의됐고 어떻게 확산됐어?')" class="text-left text-xs bg-slate-50 hover:bg-sky-50 text-slate-900 font-bold p-2 rounded-lg border border-slate-300 transition-colors cursor-pointer">
                            💡 전세사기 피해 지원 확산 경로
                        </button>
                        <button onclick="askAgentPredefined('지역 소멸 대응 정책의 최초 발원지와 다음 달 예측은?')" class="text-left text-xs bg-slate-50 hover:bg-sky-50 text-slate-900 font-bold p-2 rounded-lg border border-slate-300 transition-colors cursor-pointer">
                            💡 지역 소멸 이슈 최초 발원 및 예측
                        </button>
                        <button onclick="askAgentPredefined('전기차 화재 대책을 가장 먼저 다룬 의회는 어디야?')" class="text-left text-xs bg-slate-50 hover:bg-sky-50 text-slate-900 font-bold p-2 rounded-lg border border-slate-300 transition-colors cursor-pointer">
                            💡 전기차 화재 안전 대책
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Prompt Input Form -->
        <div class="p-3 bg-white border-t border-slate-200 shrink-0">
            <form onsubmit="handleAgentSubmit(event)" class="flex items-center space-x-2">
                <input type="text" id="agentInputQuery" placeholder="정책 이슈 질문 입력 (예: 늘봄학교 논의 흐름)..." class="flex-1 px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs md:text-sm text-slate-950 placeholder-slate-500 focus:outline-none focus:border-sky-600 font-bold shadow-inner">
                <button type="submit" class="px-4 py-2.5 bg-sky-700 hover:bg-sky-600 text-white rounded-xl text-xs md:text-sm font-black shadow-md transition-all flex items-center justify-center shrink-0 cursor-pointer">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 px-6 py-4 text-sm text-slate-700 flex flex-col sm:flex-row items-center justify-between gap-2 shrink-0 shadow-inner">
        <div class="flex items-center space-x-2 font-bold">
            <span class="text-slate-950 font-black">TEAM 꺼드럭's</span>
            <span>|</span>
            <span>2026 KISTI 데이터·AI 분석 경진대회 출품작</span>
        </div>
        <div class="flex items-center space-x-3 text-xs font-mono font-bold text-slate-600">
            <span>17개 시·도의회 정책 시공간 확산 및 미래 예측 인텔리전스</span>
        </div>
    </footer>

    <!-- Local Environment Variables (Generated from .env, Git-ignored) -->
    <script src="env.js"></script>
    <!-- Main JavaScript Application Logic -->
    <script src="app.js"></script>
</body>
</html>
